# NVIDIA_API_KEY: NVIDIA Nemotron API authentication key used in the Authorization header.
NVIDIA_API_KEY=your-nvidia-api-key

# NVIDIA_BASE_URL: Base URL for the NVIDIA hosted OpenAI-compatible API.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA_MODEL: Default NVIDIA Nemotron model name used for recipe generation requests.
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# SERVER_PORT: Local server port that the Food app will call.
SERVER_PORT=8000
